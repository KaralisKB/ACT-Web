# Copy this file to .env.local after registering the new Firebase web app.
# Paste the web configuration values from Firebase Project settings.
# Leave PROJECT_ID blank to use the owned ACT Firebase project in the code.
# Restart npm start after editing .env.local.
# These values are bundled into the browser. Never put a service-account
# private key or Admin SDK credentials in a REACT_APP_ variable.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Optional: override the existing Finnhub market-data key.
REACT_APP_FINNHUB_API_KEY=
# Optional: set this only when a real AI analysis service is available.
REACT_APP_AI_API_URL=
